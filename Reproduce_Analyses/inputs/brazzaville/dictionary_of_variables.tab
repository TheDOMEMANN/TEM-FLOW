Variable	Variablename(ENG)	Variabledescription	Datatype	Values&labels
"season"	"Season"	""	"string"	"[ss: dry season; sp: rainy season]"
"nom_marche"	"Name of the market"	""	"string"	""
"type_produit"	"Name of the vegetable"	""	"string"	""
"unite_de_transaction_vente"	"Transaction unit"	"Observed transaction unit"	"string"	"[Botte: Bundle. Seau: Bucket. Tas: Pile. Planche: bed of crops still in the field. Piece: piece. Sac: Bag. Caisse: crate/box.]"
"poids_kg"	"Transaction unit weight kg"	"Observed weight of transaction units in kilograms. For example, a crate of tomatoes at the Kibeliba market weighs 48 kg."	"numeric"	"kg"
"nb_unite"	"Number of transaction units"	"Count of transaction units observed on the day of the survey. For example, 7 crates of tomatoes at the Kibeliba market."	"numeric"	""
"prix_ut"	"Price per transaction unit"	"Observed selling price of each transaction unit on the day of the survey. For example, each crate of tomatoes at the Kibeliba market is sold for 18,000 FCFA."	"numeric"	"$FCFA/ut"
"valeur_total_f_cfa"	"Total value FCFA"	"Total value of marketed flows per product, estimated using the observed number of transaction units and the price per transaction unit (number_of_transaction_units × price_per_transaction_unit)."	"numeric"	"$FCFA"
"volume_total_kg"	"Total volume"	"Total volume of marketed flows per product, estimated using the observed number of transaction units and the observed weight of transaction units (transaction_unit_weight_kg × number_of_transaction_units)"	"numeric"	""
"nb_grossistes"	"Number of wholesalers"	"Count of wholesalers present in the market for a given product at the time of the survey."	"numeric"	""
"origine_produit"	"Product origin"	"Origin of the product as reported by wholesalers on the day of the survey"	"string"	""
"origine_produit_2"	"Secondary product origin"	"Secondary origin of the product reported by wholesalers on the day of the survey, if applicable"	"string"	""
"origine_produit_3"	"Additional product origin 3"	"Additional origin of the product reported by wholesalers on the day of the survey, if applicable"	"string"	""
"origine_produit_4"	"Additional product origin 4"	"Additional origin of the product reported by wholesalers on the day of the survey, if applicable"	"string"	""
